{
  "name": "sednium-cowork",
  "version": "1.0.0",
  "description": "Pair programming platform between one human, one phone, and several AI coding agents (Antigravity, Claude Code, Cursor, Windsurf) across machines with a live web dashboard, advisory file locks, and git handoffs.",
  "license": "MIT",
  "author": "Ankush Das <udas44647@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnkushDas4/sednium-cowork.git"
  },
  "homepage": "https://cowork.sednium.com",
  "type": "module",
  "bin": {
    "cowork": "./bin/cowork.cjs",
    "sednium-cowork": "./bin/cowork.cjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:relay": "npm --workspace=@sednium/cowork-web-relay run dev",
    "dev:mcp": "npm --workspace=@sednium/cowork-mcp run dev",
    "bundle:mcp": "esbuild packages/cowork-mcp/src/index.ts --bundle --platform=node --format=cjs --outfile=bin/cowork.cjs",
    "build": "npm run bundle:mcp && npm run build --workspaces",
    "test": "vitest run",
    "typecheck": "tsc -p packages/cowork-mcp/tsconfig.json --noEmit && npm --workspace=@sednium/cowork-web-relay run typecheck",
    "verify:relay": "node scripts/verify-relay.mjs",
    "mcp:install": "node scripts/install-mcp.mjs",
    "sync:assets": "node scripts/sync-client-assets.mjs",
    "video:studio": "npm --workspace=@sednium/cowork-video run studio",
    "video:render": "npm --workspace=@sednium/cowork-video run render"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
