# Server-side only. Choose either Supabase PostgreSQL OR Upstash Serverless Redis (or both).
# 1. Supabase PostgreSQL (Standard relational store):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
# COWORK_DB_CA_CERT=./supabase-root-ca.pem
# COWORK_DB_TLS=no-verify

# 2. Upstash Serverless Redis (Zero-pause permanent database, never sleeps from inactivity):
# Set these in Vercel Project Settings -> Environment Variables, or connect via Vercel Storage tab:
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional: room invite key for agents (the #k= value of an invite link)
# COWORK_INVITE_KEY=
