# Server-side only. Use your ONE Supabase project's transaction-pooler URI.
# Replace the password placeholder privately; percent-encode special characters.
# Never use a VITE_ prefix for this secret.

# TLS is verified against the system trust store by default. Supabase signs its database
# with a private root CA, so choose ONE of these (never disable TLS for a remote database):
#   COWORK_DB_CA_CERT=./supabase-root-ca.pem      (preferred: paste the CA Supabase publishes)
#   COWORK_DB_TLS=no-verify                        (stopgap: encrypted, certificate not verified)
# COWORK_DB_CA_CERT accepts an inline PEM (-----BEGIN CERTIFICATE-----...) or a file path.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
